{
  "name": "intellmeet-backend",
  "version": "2.0.0",
  "description": "IntellMeet - AI-Powered Enterprise Meeting & Collaboration Platform Backend (Node.js/Express/WebRTC/Socket.io)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=routes --watch-path=services --watch-path=models --watch-path=middleware server.js",
